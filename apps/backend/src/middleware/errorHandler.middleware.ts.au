understanding:
  summary: "Global error handling middleware and custom operational error class."
  purpose: "Standardizes error responses across the API and distinguishes between expected and
    unexpected failures."
  exports:
    - name: "AppError"
      kind: "class"
      description: "Custom Error class for operational/business logic errors"
    - name: "errorHandler"
      kind: "function"
      description: "Express middleware for processing errors"
  key_logic: "Intercepts errors; if it's an AppError, returns the specified status code and message.
    Otherwise, logs the error and returns a 500 Internal Server Error."

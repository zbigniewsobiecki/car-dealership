understanding:
  summary: "Authentication and authorization middleware."
  purpose: "Protects routes by verifying JWT tokens and enforcing role-based access control (RBAC)."
  exports:
    - name: "authenticateToken"
      kind: "function"
      description: "Middleware to verify Bearer JWT in Authorization header"
    - name: "requireRole"
      kind: "function"
      description: "Higher-order middleware to restrict access to specific UserRoles"
  key_logic: "Extracts token -> verifies with jwtUtils -> attaches decoded user to req.user.
    requireRole checks req.user.role against permitted roles."
relationships:
  depends_on:
    - ref: "au:apps/backend/src/utils/jwt.util.ts"
      symbols:

  summary: "Business logic for processing car sales and transactions."
  purpose: "Handles sale creation, updates, and deletion while maintaining referential integrity and
    updating vehicle inventory status."
  exports:
    - name: "salesService"
      kind: "const"
      description: "Methods for sales management and statistics"
  key_logic:
    Transitions: "When a sale status changes to COMPLETED, the associated vehicle is marked as SOLD. If
      a completed sale is cancelled or deleted, the vehicle status is reverted to AVAILABLE."

understanding:
  summary: "Global authentication state management using Zustand."
  purpose: "Stores user profile and token information, provides login/logout actions, and persists
    state to localStorage."
  exports:
    - name: "useAuthStore"
      kind: "const"
      description: "Zustand hook for accessing and modifying auth state"
  key_logic: "Uses 'persist' middleware to sync state with 'auth-storage' in localStorage. login()
    sets localStorage tokens and updates state. logout() clears both."
